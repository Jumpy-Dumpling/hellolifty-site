---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Scrub from '../components/Scrub.astro';
import Story from '../components/Story.astro';
import Bento from '../components/Bento.astro';
import Pricing from '../components/Pricing.astro';
import FreeVsPremium from '../components/FreeVsPremium.astro';
import Waitlist from '../components/Waitlist.astro';
import Faq from '../components/Faq.astro';
import { homeFaq } from '../data/faqs';
import { appGraph, faqGraph, pageGraph, SITE_DESCRIPTION, SITE_TITLE } from '../lib/seo';

const jsonLd = [pageGraph('WebPage', SITE_TITLE, SITE_DESCRIPTION, '', Astro.site, { about: { '@id': 'https://hellolifty.com/#app' } }), appGraph(Astro.site), faqGraph(homeFaq)];
---
<Base title={SITE_TITLE} description={SITE_DESCRIPTION} image="og/home.jpg" imageAlt="Lifty: Train like it matters. A strength training app for iPhone and Android." preload="screens/today.webp" jsonLd={jsonLd}>
  <Hero />
  <Marquee />
  <FreeVsPremium />
  <Scrub />
  <Story />
  <Bento />
  <Pricing />
  <Waitlist />
  <Faq />
</Base>
