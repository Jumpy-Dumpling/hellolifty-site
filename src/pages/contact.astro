---
import Base from '../layouts/Base.astro';
import { LINKS } from '../lib/config';
---
<Base title="Contact" description="Questions, feedback, bug reports or press. Send Lifty a message and we will get back to you.">
  <section class="contact">
    <div class="wrap">
      <div class="ph-center"><div class="ph-copy">
        <span class="kicker hero-in" style="--i:0">Contact</span>
        <h1 class="hero-in" style="--i:1;margin-top:18px;font-size:clamp(42px,5.6vw,78px);letter-spacing:-.05em;line-height:.98">Say <span class="grad">hello.</span></h1>
        <p class="lede hero-in" style="--i:2;max-width:620px;margin-left:auto;margin-right:auto">Questions, feedback, bug reports, or press. We read every message and reply by email.</p>
      </div></div>

      <div class="contact-grid">
        <form class="contact-form reveal" data-contact novalidate>
          <h3>Send a message</h3>
          <div class="field-row">
            <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" autocomplete="name" maxlength="100" required /></div>
            <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" required /></div>
          </div>
          <div class="field"><label for="c-topic">What is it about?</label>
            <select id="c-topic" name="topic">
              <option value="question">A question</option><option value="feedback">Feedback or an idea</option><option value="bug">A bug</option><option value="press">Press or partnerships</option><option value="other">Something else</option>
            </select></div>
          <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" maxlength="4000" required></textarea></div>
          <input class="hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn-primary" type="submit"><span class="lbl">Send message</span><i class="i i-send"></i></button>
          <p class="form-msg" role="status" aria-live="polite"></p>
        </form>

        <div class="side">
          <div class="side-card reveal" style="--d:.06s"><i class="ico i i-chatbubbles" style="--c1:#37A2FF;--c2:#0A62F0"></i><div><h4>Feedback and ideas</h4><p>Tell us what you wish Lifty did. Good ideas have a way of shipping.</p></div></div>
          <div class="side-card reveal" style="--d:.12s"><i class="ico i i-information-circle" style="--c1:#2FD0A0;--c2:#0E9CC8"></i><div><h4>Help with your account</h4><p>Include the email you signed up with and what you were trying to do, so we can look into it.</p></div></div>
          <div class="side-card reveal" style="--d:.18s"><i class="ico i i-megaphone" style="--c1:#FF9A4D;--c2:#EE3F5A"></i><div><h4>Press and partnerships</h4><p>Choose "Press or partnerships" and tell us about your project or story.</p></div></div>
          <div class="side-card reveal" style="--d:.24s"><i class="ico i i-lock-closed" style="--c1:#8B6CFF;--c2:#5B3BE8"></i><div><h4>Your privacy</h4><p>We only use your message to reply to you. Read the <a href={LINKS.privacy} style="color:var(--blue);font-weight:700">privacy policy</a>.</p></div></div>
        </div>
      </div>
    </div>
  </section>
</Base>
