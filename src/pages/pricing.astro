---
import Base from '../layouts/Base.astro';
import SimpleHero from '../components/SimpleHero.astro';
import Pricing from '../components/Pricing.astro';
import Waitlist from '../components/Waitlist.astro';
import Faq from '../components/Faq.astro';
import { pricingFaq } from '../data/faqs';
import { crumbGraph, faqGraph, pageGraph, appGraph } from '../lib/seo';
import { TRIAL_DAYS, REFERRAL_TRIAL_DAYS, PRICE_MONTHLY, PRICE_YEARLY, PRICE_LIFETIME } from '../lib/config';

const groups = [
  { icon: 'timer', c1: '#37A2FF', c2: '#0A62F0', title: 'Train (free)', items: ['Fast set logging with last session beside every set', 'Rest timers, plate calculator and supersets', 'Cardio, timed holds, four routines and 870+ exercises'] },
  { icon: 'ribbon', c1: '#FFC857', c2: '#F08A0C', title: 'Bring it with you (free)', items: ['Import your history from Strong or Hevy', 'Backs up and syncs your workouts, works offline', 'Export your data as a CSV any time'] },
  { icon: 'people', c1: '#FF7A93', c2: '#E5334B', title: 'Connect (free)', items: ['Friends, a feed, reactions and a weekly leaderboard', 'Optional notifications for posts, comments and reactions', 'Challenges, the Apple Watch app that works without your phone, widgets and a lock screen Live Activity'] },
  { icon: 'pulse', c1: '#2FD0A0', c2: '#0E9CC8', title: 'Coach (Premium)', items: ['A written coach note every month, and a recap after each workout', 'Weights filled in for every lift, and deload calls', 'Training blocks: plan 4 to 12 weeks with deloads booked ahead', 'Your first coach note is free'] },
  { icon: 'sparkles', c1: '#5CC8FF', c2: '#12A8D6', title: 'Plan (Premium)', items: ['AI-built programs, twenty a month, and plans from a photo', 'Unlimited routines and every program, including 5/3/1', 'Seasonal themes'] },
  { icon: 'watch', c1: '#4C7DFF', c2: '#1B2F66', title: 'Understand (Premium)', items: ['Strength levels for every lift, with a forecast', 'Plateau alerts and a trend for every lift (this month against last is free)', 'Muscle balance, lift goals and your full history', 'Streak freezes, and a daily readiness read from Apple Health with HRV explained', 'Nine measurements and private progress photos'] },
  { icon: 'people', c1: '#8B6CFF', c2: '#5B3BE8', title: 'Create (Premium)', items: ['Lifty Studio AI video ideas and cloud backup for your clips', 'More original music for your videos', 'Gift a month of Premium to a friend, and a Premium badge by your name'] },
];
const title = `Lifty Pricing: ${PRICE_MONTHLY} a Month, ${PRICE_YEARLY} a Year or ${PRICE_LIFETIME} Once`;
const description = `Lifty is free to start: logging, history, friends and the Apple Watch cost nothing. Premium is ${PRICE_MONTHLY} a month or ${PRICE_YEARLY} a year, with ${TRIAL_DAYS} days free.`;
const jsonLd = [pageGraph('WebPage', title, description, 'pricing/', Astro.site, { about: { '@id': 'https://hellolifty.com/#app' } }), appGraph(Astro.site), crumbGraph([['Pricing', 'pricing/']], Astro.site), faqGraph(pricingFaq)];
---
<Base title={title} description={description} image="og/pricing.jpg" imageAlt="Lifty pricing: free to start, with Premium monthly, yearly or lifetime" jsonLd={jsonLd}>
  <SimpleHero kicker="Pricing" title="Free to start. Premium for" accent="more." lede={`Every new account gets ${TRIAL_DAYS} days of Premium, no card needed. After that, keep logging for free, or pick monthly, yearly or pay once.`} />
  <Pricing bare />
  <section class="included">
    <div class="wrap">
      <div class="head reveal"><span class="kicker">What is included</span><h2>What you get<span class="grad">.</span></h2></div>
      <div class="inc-grid">
        {groups.map((g, i) => (
          <article class="inc reveal" style={`--d:${(i % 2) * 0.07}s`}>
            <h3><i class={`ico i i-${g.icon}`} style={`--c1:${g.c1};--c2:${g.c2}`}></i>{g.title}</h3>
            <ul>{g.items.map((t) => <li><i class="i i-checkmark-circle"></i>{t}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="how">
    <div class="wrap">
      <div class="head reveal"><span class="kicker">How it works</span><h2>Simple from the first day<span class="grad">.</span></h2></div>
      <div class="how-grid">
        <article class="how-card reveal"><h3>Start free</h3><p>Make an account and get {TRIAL_DAYS} days of Premium, no card needed. A friend's code makes it {REFERRAL_TRIAL_DAYS}.</p></article>
        <article class="how-card reveal" style="--d:.07s"><h3>Keep going, or don't</h3><p>When the {TRIAL_DAYS} days end, nothing is charged. You keep logging, your history and your friends for free, and can upgrade any time.</p></article>
        <article class="how-card reveal" style="--d:.14s"><h3>Or pay once</h3><p>Lifetime is a single purchase with a starter pack in the mail 30 days after you buy, while the limited-time offer lasts.</p></article>
      </div>
    </div>
  </section>
  <Waitlist />
  <Faq items={pricingFaq} title="Pricing, good to" />
</Base>
