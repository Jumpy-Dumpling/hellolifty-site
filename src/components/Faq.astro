---
import { homeFaq } from '../data/faqs';
interface Props { items?: [string, string][]; title?: string }
const { items = homeFaq, title = 'Good to' } = Astro.props;
---
<section class="faq" id="faq">
  <div class="wrap narrow">
    <div class="head reveal"><span class="kicker">Questions</span><h2>{title} <span class="grad">know.</span></h2></div>
    <div class="qa">
      {items.map(([q, a], i) => (
        <details class="reveal" style={`--d:${i * 0.04}s`}><summary>{q}</summary><div class="ans"><p set:html={a} /></div></details>
      ))}
    </div>
  </div>
</section>
