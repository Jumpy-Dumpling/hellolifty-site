---
import { TRIAL_DAYS, REFERRAL_TRIAL_DAYS } from '../lib/config';
const free = [
  ['Log every set', 'with last time beside it, a rest timer, plates and supersets'],
  ['Your whole history', 'records, estimated maxes, streaks and four routines'],
  ['Bring your history', 'import from Strong or Hevy in a minute'],
  ['Train with friends', 'a feed, reactions, challenges and a weekly leaderboard'],
  ['Apple Watch', 'log a set from your wrist, with widgets and a Live Activity'],
  ['Yours to keep', 'cloud backup, offline logging and CSV export'],
];
const premium = [
  ['An adaptive coach', 'a written note every month, with a recap after each workout'],
  ['AI plans', 'twenty a month, plus suggested weights in every workout'],
  ['Know where you stand', 'strength levels, muscle balance, lift goals and your full history'],
  ['Protect your streak', 'freezes, plus a daily readiness read from Apple Health'],
  ['The full Studio', 'AI video ideas, clip backup and more music'],
  ['Unlimited, and generous', 'no routine limit, every program, themes, and gift a month to a friend'],
];
---
<section class="fvp" id="free">
  <div class="wrap">
    <div class="head reveal">
      <span class="kicker">Free to start</span>
      <h2>Everything you need to train, <span class="grad">free.</span></h2>
      <p>Lifty is a complete workout tracker at no cost. Premium adds the coach and the deeper insight, whenever you want it.</p>
    </div>
    <div class="fvp-grid">
      <article class="fvp-card reveal">
        <h3>Free <span class="tier free">Always</span></h3>
        <p class="sub">The whole tracker, no card needed.</p>
        <ul>{free.map(([t, d]) => <li><i class="i i-checkmark-circle"></i><span>{t} <em>{d}</em></span></li>)}</ul>
      </article>
      <article class="fvp-card prem reveal" style="--d:.08s">
        <h3>Premium <span class="tier premium">Optional</span></h3>
        <p class="sub">For when you want a coach in your corner.</p>
        <ul>{premium.map(([t, d]) => <li><i class="i i-star"></i><span>{t} <em>{d}</em></span></li>)}</ul>
      </article>
    </div>
    <p class="fvp-note reveal">Every new account starts with {TRIAL_DAYS} days of Premium, no card needed ({REFERRAL_TRIAL_DAYS} if a friend invited you). After that you keep the free app.</p>
  </div>
</section>
