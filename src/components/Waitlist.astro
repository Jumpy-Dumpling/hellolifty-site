---
import WaitlistForm from './WaitlistForm.astro';
---
<section class="cta" id="waitlist">
  <div class="wrap">
    <div class="cta-panel reveal">
      <div class="cta-orbs" aria-hidden="true"><i></i><i></i><i></i></div>
      <span class="pill"><i class="dot"></i>Launching soon</span>
      <h2>Be first in <span class="grad">line.</span></h2>
      <p class="dim">Lifty is coming to iPhone and Android. Join the waitlist and we'll email you the moment it's ready to download.</p>
      <div class="cta-form"><WaitlistForm source="footer" variant="cta" /></div>
      <div class="stores">
        <div class="store"><i class="i i-logo-apple"></i><div><small>Coming soon to the</small><b>App Store</b></div></div>
        <div class="store"><i class="i i-logo-google-playstore"></i><div><small>Coming soon to</small><b>Google Play</b></div></div>
      </div>
      <p class="fine">One email when Lifty launches. We never share your address.</p>
    </div>
  </div>
</section>
