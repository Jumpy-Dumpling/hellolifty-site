---
import type { Feature } from '../data/features';
interface Props { feature: Feature }
const { feature: f } = Astro.props;
---
<section class="hl" style={`--c1:${f.c1};--c2:${f.c2}`}>
  <div class="wrap">
    <div class="head reveal"><span class="kicker">What you get</span><h2>{f.name}, <span class="grad">in detail.</span></h2></div>
    <div class="hl-grid">
      {f.highlights.map((h, i) => (
        <article class="hl-card spot reveal" style={`--d:${(i % 3) * 0.07}s`}>
          <i class={`ico i i-${h.icon}`}></i>
          {h.tier && <span class={`tier ${h.tier}`}>{h.tier === 'premium' ? 'Premium' : 'Free'}{h.tierNote ? <em> · {h.tierNote}</em> : null}</span>}
          <h3>{h.title}</h3>
          <p>{h.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>
