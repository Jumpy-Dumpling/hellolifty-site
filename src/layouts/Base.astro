---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/tokens.css';
import '../styles/icons.css';
import '../styles/base.css';
import '../styles/sections.css';
import '../styles/pages.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import iconFont from '../assets/fonts/ionicons.woff2?url';
import { absolute, SITE_NAME, TAGLINE, SITE_DESCRIPTION } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  bare?: boolean;
}
const { title, description = SITE_DESCRIPTION, image = 'og.png', noindex = false, jsonLd = [], bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME}: ${TAGLINE}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321').href;
const imageUrl = absolute(image, Astro.site);
const graph = jsonLd.length ? { '@context': 'https://schema.org', '@graph': jsonLd } : null;
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#050A1C" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={url('favicon.png')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="preload" href={iconFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME}: ${TAGLINE}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph)} />}
  </head>
  <body>
    <div class="bg" aria-hidden="true"><i class="bg-a"></i><i class="bg-b"></i><i class="bg-grid"></i></div>
    <div class="cursor-glow" aria-hidden="true"></div>
    <a class="skip" href="#main">Skip to content</a>
    {!bare && <Nav />}
    <main id="main"><slot /></main>
    {!bare && <Footer />}
    <script>
      import '../scripts/fx';
      import '../scripts/forms';
      import '../scripts/nav';
    </script>
  </body>
</html>
